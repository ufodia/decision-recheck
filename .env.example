# Optional live model proposals. The offline demo needs none of these values.
# Set variables in your shell or a separately managed environment; .env loading
# is not automatic. Never put real keys in a brief or commit this file with keys.
DRC_MODEL_BASE_URL=https://api.openai.com/v1
DRC_MODEL_NAME=
DRC_MODEL_API_KEY=
# Modern OpenAI default. Set max_tokens only for a provider requiring that legacy field.
DRC_MODEL_TOKEN_PARAMETER=max_completion_tokens

# Optional browser selection. Each launch uses a separate test profile.
# Allowed: chromium (default), chrome, msedge. No silent fallback.
DRC_BROWSER_CHANNEL=chromium
